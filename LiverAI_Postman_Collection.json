                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"message\": \"What are the early stages of non-alcoholic fatty liver disease (NAFLD) and how is it diagnosed?\",\n  \"history\": [\n    {\n      \"role\": \"user\",\n      \"content\": \"Hello LiverAI\"\n    },\n    {\n      \"role\": \"assistant\",\n      \"content\": \"Hello! I am your AI clinical liver health assistant. How can I assist you today?\"\n    }\n  ],\n  \"image_path\": null,\n  \"doc_content\": null\n}"
