# ====================================================================
# LiverAI - Environment Variables Template
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control!
# ====================================================================

# -- Required API Keys ------------------------------------------------
# Google Gemini API key -- get it at: https://aistudio.google.com/app/apikey
# Used for: AI chatbot responses (Gemini 1.5 Pro / Flash models)
GOOGLE_API=your_google_gemini_api_key_here

# DeepSeek API key -- get it at: https://platform.deepseek.com/api_keys
# Used for: DeepSeek AI reasoning and chat responses (deepseek-chat / deepseek-reasoner)
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_MODEL=deepseek-chat

# Pinecone vector database key -- get it at: https://app.pinecone.io
# Used for: storing and retrieving medical knowledge embeddings
PINECONE_API_KEY=your_pinecone_api_key_here

# HuggingFace token -- get it at: https://huggingface.co/settings/tokens
# Used for: sentence-transformer embedding model download
HUGGINGFACE_API_KEY=your_huggingface_token_here

# -- Flask Configuration -----------------------------------------------
# Change this to a long, random string before deploying to production.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=change-this-to-a-random-secret-string

# LangChain user agent (suppresses USER_AGENT warnings)
USER_AGENT=LiverAI-Chatbot/1.0

# -- Server Settings ---------------------------------------------------
# Host to listen on:
#   127.0.0.1 = localhost only (default, most secure for development)
#   0.0.0.0   = all network interfaces (needed for LAN / iOS access)
HOST=127.0.0.1

# Port to listen on.
# NOTE for macOS Monterey+: port 5000 is used by AirPlay Receiver.
# Change to 5001 if you get "Address already in use" on macOS.
PORT=5000

# Enable Flask debug mode (hot-reload + verbose errors).
# Set to false in production!
FLASK_DEBUG=false

# -- Database Configuration --------------------------------------------
# DB_TYPE=sqlite  uses the local database.db file (default, no extra setup)
# DB_TYPE=mysql   requires a running MySQL server and credentials below
DB_TYPE=sqlite

# MySQL credentials (only needed when DB_TYPE=mysql)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DB=liverai_db

# -- Firebase Configuration --------------------------------------------
# Firebase enables Google, GitHub, Twitter and Facebook social login.
# Leave the values blank to disable social login (email/password still works).
# Get these from: Firebase Console > Project Settings > Your Apps > Web App
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=

# Path to your Firebase Admin SDK service-account JSON file.
# Download from: Firebase Console > Project Settings > Service Accounts
FIREBASE_SERVICE_ACCOUNT_PATH=firebase-service-account.json

# -- Facebook OAuth (Optional) ----------------------------------------
# Required only if you want Facebook social login via Firebase.
# Get from: https://developers.facebook.com > Your App > Settings > Basic
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
